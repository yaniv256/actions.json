    "test:delegated-discovery-live": "npm run build:a11y-bundle && xvfb-run -a node extensions/chrome-overlay-runtime/tests/live/delegated-agent-discovery-smoke.mjs",
    "test:editable-lifecycle-live": "npm run build:a11y-bundle && xvfb-run -a node extensions/chrome-overlay-runtime/tests/live/background-editable-liveness-smoke.mjs",
    "test:beforeunload-dialog-live": "xvfb-run -a node extensions/chrome-overlay-runtime/tests/live/beforeunload-dialog-live-smoke.mjs",
    "test:gated-repeat-live": "xvfb-run -a node extensions/chrome-overlay-runtime/tests/live/gated-repeat-smoke.mjs",

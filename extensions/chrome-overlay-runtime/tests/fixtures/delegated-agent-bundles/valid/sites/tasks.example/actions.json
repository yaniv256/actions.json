{
  "protocol": "actions.json",
  "surface": {
    "origin": "https://tasks.example"
  },
  "state_projections": [
    {
      "name": "tasks.items",
      "snapshot": {
        "version": 1,
        "source": "dom",
        "extract": []
      },
      "postconditions": {
        "tasks.create": {
          "projection": "tasks.items",
          "verify": {
            "language": "jsonata",
            "expression": "{% $count(items[title = input.title]) = 1 %}"
          }
        }
      }
    }
  ],
  "tools": [
    {
      "name": "tasks.list",
      "description": "List visible tasks.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "maxLength": 200 },
                "complete": { "type": "boolean" }
              },
              "required": ["title", "complete"],
              "additionalProperties": false
            }
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "workflow": {
        "version": 1,
        "expression_language": "jsonata",
        "steps": [
          {
            "id": "readTasks",
            "primitive": "locator.element_info",
            "args": { "locator": { "selector": "[data-task]" } }
          }
        ]
      }
    },
    {
      "name": "tasks.create",
      "description": "Create one task.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 200 }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "created": { "type": "boolean" },
          "title": { "type": "string", "maxLength": 200 }
        },
        "required": ["created", "title"],
        "additionalProperties": false
      },
      "workflow": {
        "version": 1,
        "expression_language": "jsonata",
        "steps": [
          {
            "id": "typeTitle",
            "primitive": "text.type",
            "args": { "text": "{% input.title %}" }
          },
          {
            "id": "submit",
            "primitive": "keyboard.press",
            "args": { "key": "ENTER" }
          }
        ]
      }
    }
  ]
}
